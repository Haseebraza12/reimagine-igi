{
  "name": "igi-web-port",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Project I.G.I. browser-native vertical slice (hobby reimplementation, original assets never redistributed)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run bundle:raw",
    "bundle:raw": "node scripts/bundle-raw.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "stage": "node scripts/stage-raw.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
